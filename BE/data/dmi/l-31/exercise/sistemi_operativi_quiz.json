    "attachments": [],
    "is_active": true,
    "is_hidden": false,
    "data": {
      "lines": [
        "produttore:",
        "  while (true) {",
        "    item = produci();",
        "    wait(mutex);",
        "    wait(empty);",
        "    inserisci(item);",
        "    signal(mutex);",
        "    signal(full);",
        "  }"
      ],
      "language": "pseudocodice",
      "error_lines": [
        4
      ],
      "reasons": [
        {
          "id": "m1dcebe6354",
          "text": "Con il buffer pieno si blocca su empty tenendo il mutex: il consumatore non entra più"
        },
        {
          "id": "m6f95b23c76",
          "text": "signal(full) va prima di signal(mutex)"
        },
        {
          "id": "mb47c1198d6",
          "text": "Manca wait(full)"
        }
      ],
      "correct_reason": "m1dcebe6354",
      "fix": "Prima wait(empty), poi wait(mutex)."
    },
