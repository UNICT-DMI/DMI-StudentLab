  {
    "id_exercise": "2",
    "type": "ordina",
    "text": "Metti in ordine i messaggi dell’apertura di una connessione TCP (three-way handshake).",
    "hint": "",
    "explanation": "Il three-way handshake sincronizza i numeri di sequenza dei due lati prima dello scambio di dati.",
    "estimed_time": 60,
    "metadata": {
      "argoment": "Livello di trasporto",
      "teacher": [
        "Francesco Rundo",
        "Federico Fausto Santoro"
      ],
      "year_of_validity": "2025/2026",
      "difficulty": 2
    },
    "attachments": [],
    "is_active": true,
    "is_hidden": false,
    "data": {
      "items": [
        {
          "id": "pc5af2f0dc6",
          "text": "Il client invia SYN con il suo numero di sequenza iniziale"
        },
        {
          "id": "p5ee5cee93c",
          "text": "Il server risponde con SYN-ACK"
        },
        {
          "id": "p102ff928f0",
          "text": "Il client invia ACK: la connessione è stabilita"
        },
        {
          "id": "pfa599d840d",
          "text": "Il client inizia a inviare dati"
        }
      ],
