  {
    "id_exercise": "1",
    "type": "ordina",
    "text": "Metti in ordine i passi dell’algoritmo di Dijkstra.",
    "hint": "Il nodo scelto si chiude prima di aggiornare i vicini.",
    "explanation": "Dijkstra chiude a ogni passo il nodo con distanza provvisoria minima: quella distanza è definitiva perché i pesi non sono negativi. Poi rilassa gli archi uscenti.",
    "estimed_time": 60,
    "metadata": {
      "argoment": "Livello di rete — Control plane",
      "teacher": [
        "Francesco Rundo",
        "Federico Fausto Santoro"
      ],
      "year_of_validity": "2025/2026",
      "difficulty": 2
    },
    "attachments": [],
    "is_active": true,
    "is_hidden": false,
    "data": {
      "items": [
        {
          "id": "pe8083bfadc",
          "text": "Inizializza D(v) = ∞ per ogni nodo e D(s) = 0 per la sorgente"
        },
        {
          "id": "p2114027314",
          "text": "Scegli il nodo non visitato con D minima"
        },
        {
          "id": "pc2c2182b3f",
          "text": "Segna il nodo scelto come visitato"
        },
        {
          "id": "pc2124cbe20",
          "text": "Aggiorna le distanze dei vicini non visitati"
        },
        {
          "id": "pcd736d8775",
          "text": "Ripeti finché restano nodi non visitati"
        }
      ],
      "order": [
        "pe8083bfadc",
        "p2114027314",
